# ============================================================
# NEXUS AI — Environment Configuration
# ============================================================
# Copy this file to .env (dev) or .env.prod (production) and
# fill in every value marked CHANGE_ME before starting.
#
# NEVER commit the filled-in .env / .env.prod file.
# Only this .env.example template belongs in source control.
# ============================================================

# ── Public domain / deployment ────────────────────────────────────────────────
# The public hostname that Caddy will serve.
# For local dev: leave as "localhost" (HTTP only).
# For production: set to your real domain, e.g. nexus.example.com
DOMAIN=localhost

# Comma-separated list of allowed CORS origins for the FastAPI backend.
# In production, match your public frontend URL.
ALLOWED_ORIGINS=http://localhost:3000

# Public URLs baked into the Next.js frontend at build time.
# Set to your public domain in production.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPERSET_URL=http://localhost:8088

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME_strong_pg_password
POSTGRES_DB=nexus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=nexus
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_strong_mongo_password
MONGO_HOST=mongo
MONGO_PORT=27017

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── n8n workflow orchestrator ─────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password
N8N_HOST=n8n
N8N_PORT=5678
# Must match X-Internal-Secret used by all internal API calls.
N8N_WEBHOOK_SECRET=CHANGE_ME_shared_internal_secret_32chars
# Public webhook URL (used by n8n when generating webhook URLs in the UI).
# In production, point to your Caddy-proxied domain.
N8N_WEBHOOK_URL=http://localhost:5678
# Set to "false" when running behind an HTTP reverse proxy (Caddy handles TLS).
N8N_SECURE_COOKIE=false

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
# At least 32 random characters.  Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_at_least_32_random_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# File storage root — must match the Docker volume mount.
STORAGE_DIR=/storage
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── ML service ────────────────────────────────────────────────────────────────
# Internal Docker-network URL used by the backend to call the ML service.
ML_SERVICE_URL=http://ml-service:8100

# ── AI recommendations (Anthropic / Claude) ───────────────────────────────────
# Leave empty to use the built-in rule-based fallback (no LLM calls).
# Obtain a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── SMTP / email notifications (optional) ─────────────────────────────────────
# Leave SMTP_USER empty to disable email notifications entirely.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Default recipient for pipeline notifications; falls back to SMTP_USER.
NOTIFICATION_EMAIL=

# ── Apache Superset ───────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 42
SUPERSET_SECRET_KEY=CHANGE_ME_superset_secret_key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=CHANGE_ME_superset_admin_password
SUPERSET_ADMIN_EMAIL=admin@nexus.ai

# ── Backup ────────────────────────────────────────────────────────────────────
# Cron expression for automated backups (default: 2:00 AM UTC daily).
BACKUP_SCHEDULE=0 2 * * *
# Number of daily backup snapshots to keep before pruning.
BACKUP_RETENTION_DAYS=7
