# ── Stage 1: install dependencies ────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Stage 2: lean runtime image ───────────────────────────────────────────────
FROM python:3.12-slim AS runtime

# Non-root user for least-privilege execution
RUN groupadd --gid 1001 appgroup \
 && useradd  --uid 1001 --gid appgroup --no-create-home --shell /sbin/nologin appuser

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code (chown so non-root can run alembic + write logs)
COPY --chown=appuser:appgroup . .

# curl is used by the Docker health-check
RUN apt-get update -qq && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

USER appuser
EXPOSE 8000

# Alembic migrations run first so the schema is always up to date before
# the API starts accepting traffic.  Use 4 Uvicorn workers in production.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4 --proxy-headers --forwarded-allow-ips='*'"]
