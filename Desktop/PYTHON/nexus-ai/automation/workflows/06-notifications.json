{
  "name": "06-Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notifications",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "node-06-webhook",
      "name": "Webhook: Notifications",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "notifications-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nreturn [{\n  json: {\n    job_id: body.job_id || '',\n    subject: body.subject || 'NEXUS AI — Pipeline notification',\n    body: body.body || 'Pipeline event occurred.',\n    to_email: body.to_email || null\n  }\n}];"
      },
      "id": "node-06-extract",
      "name": "Extract Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "http://backend:8000/internal/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "x-internal-secret", "value": "={{ $env.INTERNAL_SECRET || 'change_me_shared_secret' }}" }
          ]
        },
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ job_id: $json.job_id, subject: $json.subject, body: $json.body, to_email: $json.to_email }) }}"
      },
      "id": "node-06-notify",
      "name": "Send Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst sent = result.sent;\nconst msg = result.message || '';\nconsole.log(`[06] Notification result: sent=${sent}, message=${msg}`);\nreturn [{ json: { sent, message: msg, stage: 'notification-complete' } }];"
      },
      "id": "node-06-log",
      "name": "Log Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook: Notifications": {
