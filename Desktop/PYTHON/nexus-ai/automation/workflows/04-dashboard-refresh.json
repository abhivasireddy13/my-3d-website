{
  "name": "04-Dashboard-Refresh",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dashboard-refresh",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "node-04-webhook",
      "name": "Webhook: Dashboard Refresh",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "dashboard-refresh-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst jobId = body.job_id || null;\nreturn [{ json: { job_id: jobId, timestamp: new Date().toISOString() } }];"
      },
      "id": "node-04-extract",
      "name": "Extract Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Superset queries live data — no push refresh needed.\n// This node is a placeholder; swap in a Superset/Power BI REST call here\n// if a push-based dashboard is ever adopted.\nconst item = $input.first().json;\nconsole.log(`[04] Dashboard refresh logged for job ${item.job_id} at ${item.timestamp}`);\nreturn [{ json: { job_id: item.job_id, dashboard_status: 'live_query_no_refresh_needed' } }];"
      },
      "id": "node-04-noop",
      "name": "Log Dashboard Refresh",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "http://backend:8000/internal/pipeline-callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "x-internal-secret", "value": "={{ $env.INTERNAL_SECRET || 'change_me_shared_secret' }}" }
          ]
        },
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ job_id: $('Extract Payload').first().json.job_id, status: 'modeling', stage: 'dashboard-refresh', metadata: { dashboard_status: $json.dashboard_status } }) }}"
      },
      "id": "node-04-callback",
      "name": "Pipeline Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Webhook: Dashboard Refresh": {
      "main": [[{ "node": "Extract Payload", "type": "main", "index": 0 }]]
    },
    "Extract Payload": {
      "main": [[{ "node": "Log Dashboard Refresh", "type": "main", "index": 0 }]]
    },
    "Log Dashboard Refresh": {
      "main": [[{ "node": "Pipeline Callback", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "04-dashboard-refresh-v1",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "id": "04-dashboard-refresh",
  "tags": []
}
